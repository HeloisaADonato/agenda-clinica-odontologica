# Copie este arquivo para .env e preencha. O .env nunca vai para o GitHub.

# String de conexão do MongoDB Atlas, com a senha do usuário do banco.
MONGODB_URI=mongodb+srv://USUARIO:SENHA@ENDERECO.mongodb.net/?retryWrites=true&w=majority

# Nome do banco de dados.
MONGODB_BANCO=clinica

# Chave que assina os tokens de login: texto aleatório com 32 caracteres ou mais.
JWT_SECRET=

# Endereços autorizados a chamar a API, separados por vírgula.
ORIGENS_PERMITIDAS=https://heloisaadonato.github.io,http://localhost:5500,http://127.0.0.1:5500

PORT=3000
